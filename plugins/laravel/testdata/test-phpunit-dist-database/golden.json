{
  "recipes": {
    "laravel": {
      "detected": "artisan exists",
      "layer": {
        "processes": {
          "queue": {
            "command": "php artisan queue:work"
          },
          "web": {
            "command": "PHP_INI_SCAN_DIR=$PHP_INI_SCAN_DIR:{php_ini_dir} PHP_CLI_SERVER_WORKERS=8 php artisan serve --host=127.0.0.1 --port={port} --no-reload",
            "primary": true,
            "static_dir": "public"
          }
        },
        "env": {
          "APP_URL": "{url}",
          "DB_CONNECTION": "mysql",
          "DB_DATABASE": "{db}",
          "DB_HOST": "{db_host}",
          "DB_PASSWORD": "{db_password}",
          "DB_PORT": "{db_port}",
          "DB_USERNAME": "{db_username}",
          "MAIL_HOST": "{mailpit_host}",
          "MAIL_MAILER": "smtp",
          "MAIL_PORT": "{mailpit_port}"
        },
        "linked_env": {
          "CACHE_PREFIX": "{project}_{worktree}_",
          "REDIS_PREFIX": "{project}_{worktree}_"
        },
        "services": {
          "mailpit": ""
        },
        "worktree": {
          "on_create": [
            "composer install",
            "grep -Eq \"^APP_KEY=[\\\"']?[^\\\"'[:space:]#]\" .env || php artisan key:generate",
            "php artisan storage:link"
          ]
        },
        "database": {
          "engine": "mysql"
        }
      },
      "test_database": true,
      "test_database_warnings": [
        "phpunit.xml.dist sets DB_DATABASE to \"testing\", so the Project's tests use that database instead of the Worktree's Test Database; remove DB_DATABASE from phpunit.xml.dist and let .env.testing set it (Laneway patches .env.testing, but never edits phpunit.xml.dist)"
      ],
      "test_env": {
        "file": ".env.testing",
        "layered": false
      }
    }
  }
}
